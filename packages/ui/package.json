{
  "name": "vespoli-ui",
  "version": "0.1.1",
  "description": "Controlled React components for clear, accessible data interfaces.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./style-contract": {
      "types": "./dist/style-contract.d.ts",
      "import": "./dist/style-contract.js",
      "require": "./dist/style-contract.cjs"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node ../../scripts/build-ui.ts --library",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/susanbeasles/vespoli-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/susanbeasles/vespoli-ui#readme",
  "bugs": {
    "url": "https://github.com/susanbeasles/vespoli-ui/issues"
  },
  "keywords": [
    "react",
    "typescript",
    "components",
    "accessible",
    "controlled",
    "design-system"
  ]
}

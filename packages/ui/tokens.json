{
  "$schema": "vespoli-ui/theme/v1",
  "base": {
    "font.body": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
    "font.mono": "ui-monospace, SFMono-Regular, Consolas, monospace",
    "space.1": "0.25rem",
    "space.2": "0.5rem",
    "space.3": "0.75rem",
    "space.4": "1rem",
    "space.6": "1.5rem",
    "radius.sm": "0.375rem",
    "radius.md": "0.625rem",
    "motion.fast": "120ms",
    "motion.normal": "180ms"
  },
  "light": {
    "color.background": "#eeeae0",
    "color.panel": "#f8f5ef",
    "color.raised": "#ffffff",
    "color.border": "#b8bcb1",
    "color.text": "#17231f",
    "color.muted": "#536057",
    "color.accent": "#ba4627",
    "color.onAccent": "#ffffff",
    "color.accentHover": "#97381f",
    "color.hover": "#e0e5dc",
    "color.selected": "#dfebe2",
    "color.danger": "#9a302d",
    "color.warning": "#825000"
  },
  "dark": {
    "color.background": "#111916",
    "color.panel": "#19241f",
    "color.raised": "#24332b",
    "color.border": "#45554a",
    "color.text": "#eeeae0",
    "color.muted": "#b0baaf",
    "color.accent": "#f47c52",
    "color.onAccent": "#171c18",
    "color.accentHover": "#ff9c7b",
    "color.hover": "#304237",
    "color.selected": "#294638",
    "color.danger": "#ffaaa7",
    "color.warning": "#f6d89a"
  }
}
